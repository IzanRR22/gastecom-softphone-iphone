// Gastecom Softphone — Xcode Build Configuration
// Aplica sobre la configuración base de linphone-iphone
// Uso: en Xcode → Project → Info → Configuration → añadir este fichero

PRODUCT_BUNDLE_IDENTIFIER = es.gastecom.softphone
PRODUCT_NAME = Gastecom
MARKETING_VERSION = 6.1.0
CURRENT_PROJECT_VERSION = 1

// Equipo de desarrollo (rellenar con Team ID de Apple Developer)
DEVELOPMENT_TEAM = XXXXXXXXXX

// Minimum deployment target
IPHONEOS_DEPLOYMENT_TARGET = 15.0

// Swift version
SWIFT_VERSION = 5.10

// Iconos
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Linphone SDK — descargar desde CocoaPods (ver Podfile)
LINPHONE_SDK_VERSION = 5.5
